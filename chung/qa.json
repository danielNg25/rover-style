      },
      "_style_floors_doc": "Channel character design: big head (about 2.4-2.9 heads tall, so the head ends at 0.34-0.46 of the height), compact figure. Ranges are the lead's reference measurement (0.40) and our approved front picture (0.35), widened; calibrate on more reference figures."
    },
    "gen": {
      "max_refs": 3,
      "min_prompt_chars": 80,
      "style_marker": "ART STYLE",
      "timeout_s": 300,
      "_doc": "pose_patterns: regular expressions (verb stems with their endings, English and Vietnamese), matched case-insensitively between letter boundaries after '_' becomes a space and spaced-out letters are joined; pose_exceptions are harmless phrases removed first. A prompt that matches is refused unless GEN_ALLOW_POSE=1. A word list cannot catch every paraphrase of a pose. forbidden_ref_pattern: tested on every folder and file name of the given path AND of its real path (symlinks resolved). reference_image_globs: images there are hashed; a byte-identical copy under another name is refused. max_per_day: ceiling of generations per calendar day over ALL run ids of one log (owner decision; changing GEN_RUN_ID does not reset it).",
      "pose_patterns": [
        "sit(s|ting)?",
        "sat",
        "seated",
        "kneel(s|ed|ing)?",
        "knelt",
        "on (his|her|its|their|one|both) knees?",
        "knees? bent",
        "bent knees?",
        "bent over",
        "walk(s|ed|ing)?",
        "run(s|ning)?",
        "ran",
        "jog(s|ging)?",
        "sprint(s|ed|ing)?",
        "strid(e|es|ing)",
        "mid[- ]?stride",
        "step(s|ping)? forward",
        "lying",
        "l(ies|ay|aid) (down|on|flat|back)",
        "reclin(e|es|ed|ing)",
        "bend(s|ing)?",
        "crouch(es|ed|ing)?",
        "squat(s|ted|ting)?",
        "jump(s|ed|ing)?",
        "leap(s|t|ed|ing)?",
        "crawl(s|ed|ing)?",
        "danc(e|es|ed|ing)",
        "(on|upon|in) (his|her|its|their|the|a) (throne|seat|chair|stool|bench|saddle)",
        "resting on",
        "ngồi",
        "quỳ",
        "chạy",
        "nằm",
        "nhảy",
        "đi bộ",
        "bước đi",
        "cúi"
      ],
      "pose_exceptions": [
        "running stream",
        "running water",
        "walking stick",
        "walking cane"
      ],
      "forbidden_ref_pattern": "(?<![a-z])ref(s|erence|erences)?(?![a-z])",
      "reference_image_globs": [
        "../ref/*",
        "../ref/*/*",
        "ref/*",
        "ref/*/*",
        "qa/ref*/*",
        "qa/*-ref/*",
        "qa/*ref*/*/*",
        "gen/*ref*"
      ],
      "reference_image_max": 3000,
      "max_per_day": 16
    }
  },
